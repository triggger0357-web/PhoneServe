<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VOID ODYSSEY — Space RPG</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&family=Exo+2:ital,wght@0,300;0,400;1,300&display=swap');

  :root {
    --void: #020409;
    --deep: #060d1a;
    --panel: #0a1628;
    --border: #1a3a6b;
    --glow: #00d4ff;
    --glow2: #7b2fff;
    --gold: #ffd700;
    --danger: #ff3b3b;
    --success: #00ff88;
    --text: #c8dff5;
    --dim: #4a6a8a;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--void);
    color: var(--text);
    font-family: 'Share Tech Mono', monospace;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
  }

  /* STARFIELD */
  #starfield {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .star {
    position: absolute;
    border-radius: 50%;
    background: white;
    animation: twinkle var(--d) ease-in-out infinite alternate;
  }
  @keyframes twinkle {
    from { opacity: var(--min); transform: scale(1); }
    to { opacity: var(--max); transform: scale(1.4); }
  }
  .nebula {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.06;
    animation: drift 30s ease-in-out infinite alternate;
  }
  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(30px, -20px) scale(1.1); }
  }

  /* LAYOUT */
  #app {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 20px;
  }

  /* HEADER */
  header {
    text-align: center;
    padding: 30px 0 20px;
    position: relative;
  }
  .logo {
    font-family: 'Orbitron', monospace;
    font-weight: 900;
    font-size: clamp(28px, 6vw, 52px);
    letter-spacing: 0.15em;
    background: linear-gradient(135deg, var(--glow) 0%, var(--glow2) 50%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: none;
    position: relative;
  }
  .logo::after {
    content: 'VOID ODYSSEY';
    position: absolute;
    inset: 0;
    font-family: 'Orbitron', monospace;
    font-weight: 900;
    -webkit-text-fill-color: transparent;
    filter: blur(20px);
    background: linear-gradient(135deg, var(--glow), var(--glow2));
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0.5;
  }
  .tagline {
    font-family: 'Exo 2', sans-serif;
    font-style: italic;
    color: var(--dim);
    font-size: 13px;
    letter-spacing: 0.3em;
    margin-top: 6px;
  }

  /* STATS BAR */
  #stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 16px 0;
    display: none;
  }
  .stat-box {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .stat-box::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--glow), transparent);
    opacity: 0.5;
  }
  .stat-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--dim);
    text-transform: uppercase;
  }
  .stat-value {
    font-family: 'Orbitron', monospace;
    font-size: 18px;
    font-weight: 700;
    margin-top: 2px;
  }
  .stat-value.hp { color: var(--success); }
  .stat-value.credits { color: var(--gold); }
  .stat-value.xp { color: var(--glow2); }
  .stat-value.level { color: var(--glow); }

  /* MAIN PANEL */
  #main-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* SCENE DISPLAY */
  #scene-area {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 24px;
    position: relative;
    overflow: hidden;
    min-height: 300px;
  }
  #scene-area::before {
    content: '';
    position: absolute;
    top: -1px; left: 20%; right: 20%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--glow), var(--glow2), transparent);
    border-radius: 2px;
  }

  .scene-header {
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--glow);
    text-transform: uppercase;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .scene-header::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }
  .pulse-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--glow);
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px var(--glow); }
    50% { opacity: 0.3; box-shadow: none; }
  }

  #scene-text {
    font-family: 'Exo 2', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: var(--text);
    white-space: pre-wrap;
  }
  #scene-text .typing-cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--glow);
    animation: blink 1s step-end infinite;
    vertical-align: text-bottom;
    margin-left: 2px;
  }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* CHOICES */
  #choices-area {
    display: grid;
    gap: 8px;
  }
  .choice-btn {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: 'Share Tech Mono', monospace;
    font-size: 14px;
    padding: 14px 20px;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .choice-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--glow), var(--glow2));
    opacity: 0;
    transition: opacity 0.2s;
  }
  .choice-btn:hover::before { opacity: 0.08; }
  .choice-btn:hover {
    border-color: var(--glow);
    color: #fff;
    transform: translateX(4px);
    box-shadow: -3px 0 0 var(--glow), 0 0 20px rgba(0,212,255,0.1);
  }
  .choice-btn:active { transform: translateX(2px) scale(0.99); }
  .choice-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }
  .choice-num {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    color: var(--glow);
    background: rgba(0,212,255,0.1);
    border: 1px solid rgba(0,212,255,0.3);
    border-radius: 4px;
    padding: 2px 7px;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }
  .choice-text { position: relative; z-index: 1; }

  /* LOADING */
  #loading {
    display: none;
    align-items: center;
    gap: 12px;
    padding: 16px 0;
    color: var(--dim);
    font-size: 13px;
  }
  .loading-dots {
    display: flex; gap: 5px;
  }
  .loading-dots span {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--glow);
    animation: loadpulse 1.2s ease-in-out infinite;
  }
  .loading-dots span:nth-child(2) { animation-delay: 0.2s; }
  .loading-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes loadpulse {
    0%, 100% { opacity: 0.2; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  /* CHARACTER CREATION */
  #char-create {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 28px;
  }
  #char-create h2 {
    font-family: 'Orbitron', monospace;
    font-size: 14px;
    letter-spacing: 0.2em;
    color: var(--glow);
    margin-bottom: 6px;
  }
  #char-create p {
    font-family: 'Exo 2', sans-serif;
    color: var(--dim);
    font-size: 13px;
    margin-bottom: 20px;
  }
  .input-group { margin-bottom: 16px; }
  .input-group label {
    display: block;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--glow2);
    margin-bottom: 6px;
    text-transform: uppercase;
  }
  .input-group input, .input-group select {
    width: 100%;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-family: 'Share Tech Mono', monospace;
    font-size: 14px;
    padding: 10px 14px;
    outline: none;
    transition: border-color 0.2s;
  }
  .input-group input:focus, .input-group select:focus {
    border-color: var(--glow);
    box-shadow: 0 0 12px rgba(0,212,255,0.1);
  }
  .input-group select option { background: var(--deep); }

  .class-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 20px;
  }
  .class-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 10px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s;
  }
  .class-card:hover { border-color: var(--glow2); }
  .class-card.selected {
    border-color: var(--glow);
    background: rgba(0,212,255,0.06);
    box-shadow: 0 0 20px rgba(0,212,255,0.1);
  }
  .class-icon { font-size: 28px; margin-bottom: 8px; }
  .class-name {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    color: var(--glow);
    letter-spacing: 0.1em;
  }
  .class-desc {
    font-size: 10px;
    color: var(--dim);
    margin-top: 4px;
    font-family: 'Exo 2', sans-serif;
  }

  .start-btn {
    width: 100%;
    background: linear-gradient(135deg, rgba(0,212,255,0.15), rgba(123,47,255,0.15));
    border: 1px solid var(--glow);
    border-radius: 8px;
    color: var(--glow);
    font-family: 'Orbitron', monospace;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    padding: 16px;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }
  .start-btn:hover {
    background: linear-gradient(135deg, rgba(0,212,255,0.25), rgba(123,47,255,0.25));
    box-shadow: 0 0 30px rgba(0,212,255,0.2);
    transform: translateY(-1px);
  }

  /* LOG */
  #log-area {
    background: rgba(6,13,26,0.8);
    border: 1px solid rgba(26,58,107,0.5);
    border-radius: 8px;
    padding: 14px 16px;
    max-height: 120px;
    overflow-y: auto;
    display: none;
  }
  #log-area::-webkit-scrollbar { width: 3px; }
  #log-area::-webkit-scrollbar-track { background: transparent; }
  #log-area::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
  .log-entry {
    font-size: 12px;
    color: var(--dim);
    line-height: 1.6;
    padding: 2px 0;
    border-bottom: 1px solid rgba(26,58,107,0.2);
  }
  .log-entry:last-child { border: none; }
  .log-entry .log-tag {
    color: var(--glow2);
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .log-entry.success .log-tag { color: var(--success); }
  .log-entry.danger .log-tag { color: var(--danger); }

  /* INVENTORY PANEL */
  #inventory-bar {
    display: none;
    gap: 8px;
    flex-wrap: wrap;
  }
  .inv-item {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    color: var(--gold);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* HP BAR */
  .hp-bar-wrap {
    margin-top: 8px;
    height: 4px;
    background: rgba(255,255,255,0.05);
    border-radius: 2px;
    overflow: hidden;
  }
  .hp-bar-fill {
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--success), #00cc70);
    transition: width 0.5s ease;
  }
  .hp-bar-fill.low { background: linear-gradient(90deg, var(--danger), #ff6b00); }

  /* COMBAT EFFECTS */
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px); }
    40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(4px); }
  }
  .shake { animation: shake 0.4s ease; }

  @keyframes flash-red {
    0% { background: rgba(255,59,59,0.15); }
    100% { background: transparent; }
  }
  .flash-damage { animation: flash-red 0.5s ease; }

  /* RESPONSIVE */
  @media (max-width: 600px) {
    .class-grid { grid-template-columns: repeat(3, 1fr); }
    #stats-bar { grid-template-columns: repeat(2, 1fr); }
    .logo { font-size: 26px; }
  }
</style>
</head>
<body>

<div id="starfield"></div>

<div id="app">
  <header>
    <div class="logo">VOID ODYSSEY</div>
    <div class="tagline">AN INFINITE SPACE RPG ADVENTURE</div>
  </header>

  <div id="stats-bar">
    <div class="stat-box">
      <div class="stat-label">LEVEL</div>
      <div class="stat-value level" id="stat-level">1</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">HULL / HP</div>
      <div class="stat-value hp" id="stat-hp">100</div>
      <div class="hp-bar-wrap"><div class="hp-bar-fill" id="hp-bar" style="width:100%"></div></div>
    </div>
    <div class="stat-box">
      <div class="stat-label">CREDITS</div>
      <div class="stat-value credits" id="stat-credits">500</div>
    </div>
    <div class="stat-box">
      <div class="stat-label">XP</div>
      <div class="stat-value xp" id="stat-xp">0</div>
    </div>
  </div>

  <div id="main-panel">
    <!-- CHARACTER CREATION -->
    <div id="char-create">
      <h2>⬡ PILOT REGISTRATION</h2>
      <p>Initialize your pilot profile before launch sequence begins.</p>

      <div class="input-group">
        <label>Pilot Name</label>
        <input type="text" id="pilot-name" placeholder="Enter your name..." maxlength="24" />
      </div>

      <div class="input-group">
        <label>Choose Your Class</label>
      </div>
      <div class="class-grid">
        <div class="class-card selected" data-class="Vanguard" onclick="selectClass(this)">
          <div class="class-icon">⚔️</div>
          <div class="class-name">VANGUARD</div>
          <div class="class-desc">Frontline warrior. High HP, brutal melee.</div>
        </div>
        <div class="class-card" data-class="Ghost" onclick="selectClass(this)">
          <div class="class-icon">👤</div>
          <div class="class-name">GHOST</div>
          <div class="class-desc">Shadow operative. Stealth & deception.</div>
        </div>
        <div class="class-card" data-class="Arcane" onclick="selectClass(this)">
          <div class="class-icon">🌀</div>
          <div class="class-name">ARCANE</div>
          <div class="class-desc">Void mage. Psionic powers & tech.</div>
        </div>
        <div class="class-card" data-class="Commander" onclick="selectClass(this)">
          <div class="class-icon">🛸</div>
          <div class="class-name">COMMANDER</div>
          <div class="class-desc">Fleet tactician. Strategy & drones.</div>
        </div>
        <div class="class-card" data-class="Medic" onclick="selectClass(this)">
          <div class="class-icon">🧬</div>
          <div class="class-name">MEDIC</div>
          <div class="class-desc">Bio-engineer. Healing & nanobots.</div>
        </div>
        <div class="class-card" data-class="Scavenger" onclick="selectClass(this)">
          <div class="class-icon">🔧</div>
          <div class="class-name">SCAVENGER</div>
          <div class="class-desc">Resourceful drifter. Crafting & luck.</div>
        </div>
      </div>

      <button class="start-btn" onclick="startGame()">▶ LAUNCH SEQUENCE</button>
    </div>

    <!-- GAME AREA -->
    <div id="game-area" style="display:none; flex-direction:column; gap:14px;">
      <div id="scene-area">
        <div class="scene-header">
          <div class="pulse-dot"></div>
          <span id="location-name">UNKNOWN SECTOR</span>
        </div>
        <div id="scene-text"></div>
      </div>

      <div id="loading">
        <div class="loading-dots"><span></span><span></span><span></span></div>
        <span>Scanning sector...</span>
      </div>

      <div id="choices-area"></div>

      <div id="inventory-bar"></div>

      <div id="log-area"></div>
    </div>
  </div>
</div>

<script>
// ═══════════════════════════════════════════════════════
//  STARFIELD
// ═══════════════════════════════════════════════════════
const sf = document.getElementById('starfield');
for (let i = 0; i < 180; i++) {
  const s = document.createElement('div');
  s.className = 'star';
  const sz = Math.random() * 2.2 + 0.3;
  s.style.cssText = `
    left:${Math.random()*100}%;top:${Math.random()*100}%;
    width:${sz}px;height:${sz}px;
    --min:${(Math.random()*0.3+0.1).toFixed(2)};
    --max:${(Math.random()*0.6+0.4).toFixed(2)};
    --d:${(Math.random()*4+2).toFixed(1)}s;
    animation-delay:${(Math.random()*5).toFixed(1)}s;
  `;
  sf.appendChild(s);
}
for (const [x, y, w, h, c] of [
  [10,20,400,300,'#0044ff'], [70,60,500,350,'#7b00ff'],
  [40,80,350,250,'#00aaff'], [80,10,300,400,'#ff0066']
]) {
  const n = document.createElement('div');
  n.className = 'nebula';
  n.style.cssText = `left:${x}%;top:${y}%;width:${w}px;height:${h}px;background:${c};animation-delay:${Math.random()*15}s;`;
  sf.appendChild(n);
}

// ═══════════════════════════════════════════════════════
//  GAME STATE
// ═══════════════════════════════════════════════════════
let player = {};
let gameHistory = [];
let selectedClass = 'Vanguard';

function selectClass(el) {
  document.querySelectorAll('.class-card').forEach(c => c.classList.remove('selected'));
  el.classList.add('selected');
  selectedClass = el.dataset.class;
}

function startGame() {
  const name = document.getElementById('pilot-name').value.trim() || 'Ghost Pilot';
  const classStats = {
    Vanguard:   { hp: 120, maxHp: 120, credits: 400, xp: 0, level: 1, inventory: ['⚔️ Plasma Blade', '🛡️ Exo-Armor'] },
    Ghost:      { hp: 90,  maxHp: 90,  credits: 700, xp: 0, level: 1, inventory: ['🔪 Shadow Dagger', '💊 Cloak Module'] },
    Arcane:     { hp: 80,  maxHp: 80,  credits: 500, xp: 0, level: 1, inventory: ['🌀 Void Staff', '📖 Psi-Tome'] },
    Commander:  { hp: 100, maxHp: 100, credits: 600, xp: 0, level: 1, inventory: ['🛸 Drone Unit', '📡 Tactical Array'] },
    Medic:      { hp: 100, maxHp: 100, credits: 550, xp: 0, level: 1, inventory: ['🧬 Biokit', '💉 Stim-Pack x3'] },
    Scavenger:  { hp: 95,  maxHp: 95,  credits: 800, xp: 0, level: 1, inventory: ['🔧 Multi-Tool', '🎲 Lucky Charm'] },
  };
  player = { name, class: selectedClass, ...classStats[selectedClass] };

  document.getElementById('char-create').style.display = 'none';
  document.getElementById('game-area').style.display = 'flex';
  document.getElementById('stats-bar').style.display = 'grid';
  document.getElementById('log-area').style.display = 'block';
  document.getElementById('inventory-bar').style.display = 'flex';

  updateStats();
  updateInventory();
  addLog('SYSTEM', `Pilot ${name} [${selectedClass}] — Launch sequence initiated.`);

  beginAdventure();
}

function updateStats() {
  document.getElementById('stat-level').textContent = player.level;
  document.getElementById('stat-hp').textContent = `${player.hp}/${player.maxHp}`;
  document.getElementById('stat-credits').textContent = player.credits;
  document.getElementById('stat-xp').textContent = player.xp;
  const pct = (player.hp / player.maxHp * 100) + '%';
  const bar = document.getElementById('hp-bar');
  bar.style.width = pct;
  bar.classList.toggle('low', player.hp / player.maxHp < 0.35);
}

function updateInventory() {
  const bar = document.getElementById('inventory-bar');
  bar.innerHTML = player.inventory.map(item =>
    `<div class="inv-item">${item}</div>`
  ).join('');
}

function addLog(tag, msg, type = '') {
  const log = document.getElementById('log-area');
  const entry = document.createElement('div');
  entry.className = `log-entry ${type}`;
  entry.innerHTML = `<span class="log-tag">[${tag}]</span> ${msg}`;
  log.prepend(entry);
  while (log.children.length > 30) log.lastChild.remove();
}

// ═══════════════════════════════════════════════════════
// 