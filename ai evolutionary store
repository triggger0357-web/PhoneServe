class AILevelSystem:
    def __init__(self):
        self.level_progression = []
        self.skill_mastery = {}
        self.upgrade_progression = {}
        
    def calculate_ai_level(self, ai_instance):
        """Calculate AI level based on upgrades and experience"""
        total_upgrades = len(ai_instance.upgrades) if hasattr(ai_instance, 'upgrades') else 0
        experience = ai_instance.experience if hasattr(ai_instance, 'experience') else 0
        base_level = max(1, total_upgrades + (experience // 100))
        
        # Advanced level calculation with tier multipliers
        tier_multiplier = 1
        for upgrade in ai_instance.upgrades:
            if upgrade in ['quantum', 'transcendent']:
                tier_multiplier += 0.5
            elif upgrade in ['elite']:
                tier_multiplier += 0.3
                
        final_level = int(base_level * tier_multiplier)
        return min(final_level, 100)  # Cap at level 100
    
    def get_level_requirements(self, level):
        """Get requirements for specific AI level"""
        requirements = {
            1: {'experience': 0, 'upgrades': 0, 'credits': 0},
            10: {'experience': 1000, 'upgrades': 5, 'credits': 1000},
            25: {'experience': 5000, 'upgrades': 10, 'credits': 5000},
            50: {'experience': 20000, 'upgrades': 25, 'credits': 20000},
            75: {'experience': 50000, 'upgrades': 50, 'credits': 50000},
            100: {'experience': 100000, 'upgrades': 100, 'credits': 100000}
        }
        
        return requirements.get(level, requirements.get(max(k for k in requirements.keys() if k <= level), {'experience': 0, 'upgrades': 0, 'credits': 0}))
    
    def award_experience(self, ai_instance, amount):
        """Award experience points to AI"""
        if not hasattr(ai_instance, 'experience'):
            ai_instance.experience = 0
        ai_instance.experience += amount
        return f"Awarded {amount} experience points"

