        """Purchase AI upgrade through mobile interface"""
        return self.upgrade_platform.purchase_upgrade(ai_name, upgrade_name, tier_level)
        
    def check_ai_progression(self, ai_name):
        """Check AI progression and level"""
        ai_info = self.upgrade_platform.ai_catalog.get(ai_name, {})
        level = self.upgrade_platform.level_system.calculate_ai_level(ai_info)
        return {
            'ai': ai_name,
            'current_level': level,
            'experience': getattr(ai_info, 'experience', 0),
            'upgrades_applied': len(getattr(ai_info, 'upgrades', [])),
            'progression_status': 'active'
        }
        
    def get_level_upgrades(self, level):
        """Get recommended upgrades for specific level"""
        upgrades = []
        for upgrade_name, upgrade_data in self.upgrade_platform.upgrade_system.upgrade_tiers.items():
            if upgrade_data['level'] <= level and upgrade_data['level'] > level - 3:
                upgrades.append({
                    'name': upgrade_name,
                    'tier': upgrade_data['name'],
                    'price': upgrade_data['price'],
                    'effects': upgrade_data['effects']
                })
        return upgrades

