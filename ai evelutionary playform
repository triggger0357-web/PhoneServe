class CreativeSpecializationTools:
    def __init__(self):
        self.creative_domains = {}
        self.specialization_system = CreativeSpecializationPlatform()
        self.ai_integration = AIIntegrationSystem()
        
    def get_domain_tools(self, domain_name):
        """Get specialized tools for specific creative domain"""
        domain = self.specialization_system.artistic_domains.get(domain_name, {})
        return {
            'domain': domain_name,
            'name': domain.get('name', 'Unknown'),
            'type': domain.get('type', 'mixed'),
            'specializations': domain.get('specializations', []),
            'tools': domain.get('tools', []),
            'description': domain.get('description', 'Creative domain')
        }
    
    def get_current_specialization(self, ai_name):
        """Get current specialization level for AI"""
        ai = self.specialization_system.ai_catalog.get(ai_name, {})
        return getattr(ai, 'specialization_level', 'beginner')
    
    def upgrade_specialization(self, ai_name, domain_name, new_specialization):
        """Upgrade AI specialization in specific domain"""
        if ai_name in self.specialization_system.ai_catalog:
            ai = self.specialization_system.ai_catalog[ai_name]
            ai.specialization_level = new_specialization
            ai.specialization_domain = domain_name
            ai.last_upgrade = "now"
            
            return {
                'status': 'upgraded',
                'ai': ai_name,
                'domain': domain_name,
                'new_level': new_specialization,
                'timestamp': "now"
            }
        return {
            'status': 'failed',
            'reason': 'AI not found',
            'ai': ai_name
        }

