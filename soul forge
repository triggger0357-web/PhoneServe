<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AI Evolution & Control Platform — Soul Forge v9.0</title>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Rajdhani:wght@300;400;500;600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
  :root {
    --void: #030712;
    --deep: #060e1a;
    --panel: #0a1628;
    --panel2: #0d1f38;
    --cyan: #00f5ff;
    --cyan-dim: #00c4cc;
    --plasma: #7c3aed;
    --plasma-glow: #a855f7;
    --gold: #f59e0b;
    --green: #10b981;
    --red: #ef4444;
    --text: #c8d8f0;
    --text-dim: #6b87b0;
    --border: rgba(0,245,255,0.12);
    --border-bright: rgba(0,245,255,0.35);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--void);
    color: var(--text);
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    line-height: 1.6;
    overflow-x: hidden;
  }

  /* Grid background */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,245,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,245,255,0.03) 1px, transparent 1px);
    background-size: 50px 50px;
    pointer-events: none;
    z-index: 0;
  }

  /* Animated orbs */
  .orb {
    position: fixed;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    pointer-events: none;
    z-index: 0;
    animation: drift 20s ease-in-out infinite;
  }
  .orb-1 { width: 500px; height: 500px; background: var(--plasma); top: -100px; right: -100px; animation-delay: 0s; }
  .orb-2 { width: 400px; height: 400px; background: var(--cyan); bottom: 20%; left: -100px; animation-delay: -7s; }
  .orb-3 { width: 300px; height: 300px; background: var(--plasma); bottom: -50px; right: 30%; animation-delay: -14s; }

  @keyframes drift {
    0%, 100% { transform: translate(0, 0); }
    33% { transform: translate(30px, -30px); }
    66% { transform: translate(-20px, 20px); }
  }

  /* Scanline effect */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.05) 2px, rgba(0,0,0,0.05) 4px);
    pointer-events: none;
    z-index: 1;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 16px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: rgba(3,7,18,0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
  }

  .nav-logo {
    font-family: 'Orbitron', sans-serif;
    font-weight: 900;
    font-size: 14px;
    letter-spacing: 3px;
    color: var(--cyan);
    text-transform: uppercase;
    text-shadow: 0 0 20px rgba(0,245,255,0.5);
  }

  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }

  .nav-links a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 600;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--cyan); }

  .nav-cta {
    background: transparent;
    border: 1px solid var(--cyan);
    color: var(--cyan);
    padding: 8px 20px;
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    letter-spacing: 2px;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s;
    clip-path: polygon(8px 0%, 100% 0%, calc(100% - 8px) 100%, 0% 100%);
  }

  .nav-cta:hover {
    background: var(--cyan);
    color: var(--void);
  }

  /* HERO */
  .hero {
    position: relative;
    z-index: 2;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 40px 80px;
    overflow: hidden;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(124,58,237,0.15);
    border: 1px solid rgba(124,58,237,0.4);
    color: var(--plasma-glow);
    padding: 6px 18px;
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 32px;
    animation: pulse-badge 3s ease-in-out infinite;
  }

  @keyframes pulse-badge {
    0%, 100% { box-shadow: 0 0 0 0 rgba(124,58,237,0.4); }
    50% { box-shadow: 0 0 20px 5px rgba(124,58,237,0.2); }
  }

  .hero-badge::before {
    content: '●';
    animation: blink 1s step-end infinite;
  }

  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }

  .hero h1 {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(32px, 6vw, 76px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .hero h1 .line-cyan { color: var(--cyan); text-shadow: 0 0 40px rgba(0,245,255,0.6); }
  .hero h1 .line-white { color: #fff; }
  .hero h1 .line-dim { color: var(--text-dim); font-size: 0.5em; letter-spacing: 8px; font-weight: 400; display: block; margin-bottom: 8px; }

  .hero-sub {
    font-size: 18px;
    color: var(--text-dim);
    max-width: 600px;
    margin: 24px auto 48px;
    font-weight: 400;
  }

  .hero-sub em {
    color: var(--cyan-dim);
    font-style: normal;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: linear-gradient(135deg, var(--plasma), #4f46e5);
    color: white;
    border: none;
    padding: 16px 40px;
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);
    transition: all 0.3s;
    box-shadow: 0 0 30px rgba(124,58,237,0.4);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 40px rgba(124,58,237,0.6);
  }

  .btn-secondary {
    background: transparent;
    color: var(--cyan);
    border: 1px solid var(--border-bright);
    padding: 16px 40px;
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    clip-path: polygon(12px 0%, 100% 0%, calc(100% - 12px) 100%, 0% 100%);
    transition: all 0.3s;
  }

  .btn-secondary:hover {
    background: rgba(0,245,255,0.08);
    border-color: var(--cyan);
  }

  /* STATS BAR */
  .stats-bar {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    background: var(--deep);
  }

  .stat-item {
    padding: 32px 24px;
    text-align: center;
    border-right: 1px solid var(--border);
    position: relative;
    overflow: hidden;
  }

  .stat-item:last-child { border-right: none; }

  .stat-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--cyan), transparent);
    transform: scaleX(0);
    transition: transform 0.5s;
  }

  .stat-item:hover::after { transform: scaleX(1); }

  .stat-num {
    font-family: 'Orbitron', sans-serif;
    font-size: 36px;
    font-weight: 900;
    color: var(--cyan);
    text-shadow: 0 0 20px rgba(0,245,255,0.5);
    display: block;
  }

  .stat-label {
    font-size: 12px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-top: 4px;
  }

  /* SECTIONS */
  section {
    position: relative;
    z-index: 2;
    padding: 100px 40px;
    max-width: 1400px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .section-tag {
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 12px;
    display: block;
  }

  .section-title {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(24px, 4vw, 44px);
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .section-title span { color: var(--cyan); }

  .section-desc {
    color: var(--text-dim);
    font-size: 16px;
    max-width: 560px;
    margin: 16px auto 0;
  }

  /* UPGRADE TIERS */
  .tiers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    background: var(--border);
  }

  .tier-card {
    background: var(--panel);
    padding: 36px 28px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
    cursor: default;
  }

  .tier-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
  }

  .tier-card.t1::before { background: var(--text-dim); }
  .tier-card.t2::before { background: var(--green); }
  .tier-card.t3::before { background: #3b82f6; }
  .tier-card.t4::before { background: var(--plasma-glow); }
  .tier-card.t5::before { background: var(--cyan); }
  .tier-card.t6::before { background: linear-gradient(90deg, var(--cyan), var(--plasma-glow), var(--gold)); }

  .tier-card:hover { background: var(--panel2); transform: translateY(-4px); }

  .tier-level {
    font-family: 'Share Tech Mono', monospace;
    font-size: 10px;
    letter-spacing: 3px;
    color: var(--text-dim);
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .tier-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 4px;
  }

  .tier-price {
    font-family: 'Orbitron', sans-serif;
    font-size: 28px;
    font-weight: 900;
    margin: 16px 0 8px;
  }

  .tier-card.t1 .tier-price { color: var(--text-dim); }
  .tier-card.t2 .tier-price { color: var(--green); }
  .tier-card.t3 .tier-price { color: #60a5fa; }
  .tier-card.t4 .tier-price { color: var(--plasma-glow); }
  .tier-card.t5 .tier-price { color: var(--cyan); }
  .tier-card.t6 .tier-price { background: linear-gradient(90deg, var(--cyan), var(--gold)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

  .tier-desc {
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 20px;
  }

  .tier-effects {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .effect-tag {
    background: rgba(0,245,255,0.06);
    border: 1px solid rgba(0,245,255,0.15);
    color: var(--cyan-dim);
    padding: 3px 10px;
    font-size: 11px;
    font-family: 'Share Tech Mono', monospace;
    letter-spacing: 1px;
  }

  /* CATEGORIES */
  .cats-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px;
  }

  .cat-card {
    background: var(--panel);
    border: 1px solid var(--border);
    padding: 28px 20px;
    text-align: center;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
  }

  .cat-card:hover {
    border-color: var(--border-bright);
    background: var(--panel2);
  }

  .cat-icon {
    font-size: 32px;
    margin-bottom: 16px;
    display: block;
  }

  .cat-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }

  .cat-desc {
    font-size: 12px;
    color: var(--text-dim);
    margin-bottom: 16px;
    line-height: 1.5;
  }

  .cat-slots {
    font-family: 'Share Tech Mono', monospace;
    font-size: 10px;
    color: var(--cyan);
    letter-spacing: 2px;
  }

  .cat-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    justify-content: center;
    margin-top: 12px;
  }

  .cat-tag {
    font-size: 9px;
    padding: 2px 7px;
    background: rgba(124,58,237,0.1);
    border: 1px solid rgba(124,58,237,0.2);
    color: var(--plasma-glow);
    letter-spacing: 1px;
    font-family: 'Share Tech Mono', monospace;
  }

  /* TRACKS */
  .tracks-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .track-row {
    display: grid;
    grid-template-columns: 220px 1fr auto;
    align-items: center;
    gap: 32px;
    background: var(--panel);
    padding: 28px 36px;
    border-left: 4px solid transparent;
    transition: all 0.3s;
  }

  .track-row:hover { background: var(--panel2); border-left-color: var(--cyan); }
  .track-row.technical { border-left-color: #3b82f6; }
  .track-row.communicative { border-left-color: var(--green); }
  .track-row.safety { border-left-color: var(--gold); }
  .track-row.creative { border-left-color: var(--plasma-glow); }
  .track-row.evolutionary { border-left-color: var(--cyan); }

  .track-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #fff;
  }

  .track-desc {
    font-size: 13px;
    color: var(--text-dim);
    margin-top: 4px;
  }

  .track-skills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .skill-chip {
    font-family: 'Share Tech Mono', monospace;
    font-size: 10px;
    padding: 4px 10px;
    background: rgba(0,245,255,0.04);
    border: 1px solid rgba(0,245,255,0.12);
    color: var(--text-dim);
    letter-spacing: 1px;
  }

  .track-max {
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    color: var(--text-dim);
    text-align: right;
    white-space: nowrap;
  }

  .track-max span {
    display: block;
    font-size: 20px;
    font-weight: 700;
    color: var(--cyan);
  }

  /* MASTERY */
  .mastery-timeline {
    display: flex;
    justify-content: space-between;
    position: relative;
    padding: 0 20px;
  }

  .mastery-timeline::before {
    content: '';
    position: absolute;
    top: 40px;
    left: 60px;
    right: 60px;
    height: 2px;
    background: linear-gradient(90deg, var(--text-dim), var(--cyan), var(--gold));
  }

  .mastery-node {
    text-align: center;
    width: 18%;
    position: relative;
  }

  .mastery-circle {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    border: 2px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 16px;
    font-size: 28px;
    background: var(--panel);
    position: relative;
    z-index: 1;
    transition: all 0.3s;
  }

  .mastery-node:hover .mastery-circle {
    border-color: var(--cyan);
    box-shadow: 0 0 30px rgba(0,245,255,0.3);
    transform: scale(1.1);
  }

  .mastery-title {
    font-family: 'Orbitron', sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 8px;
  }

  .mastery-bonus {
    font-size: 12px;
    color: var(--text-dim);
    line-height: 1.5;
  }

  .mastery-bonus strong {
    color: var(--gold);
    font-weight: 600;
  }

  /* SOUL FORGE */
  .soul-section {
    background: linear-gradient(180deg, var(--void) 0%, rgba(124,58,237,0.05) 50%, var(--void) 100%);
    padding: 100px 0;
  }

  .soul-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .soul-domains {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    background: rgba(124,58,237,0.15);
    border: 1px solid rgba(124,58,237,0.3);
  }

  .domain-card {
    background: var(--deep);
    padding: 40px;
    transition: all 0.3s;
  }

  .domain-card:hover {
    background: rgba(124,58,237,0.06);
  }

  .domain-icon { font-size: 40px; margin-bottom: 16px; display: block; }

  .domain-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--plasma-glow);
    margin-bottom: 8px;
  }

  .domain-desc {
    font-size: 14px;
    color: var(--text-dim);
    font-style: italic;
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .domain-specializations {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }

  .spec-tag {
    font-family: 'Share Tech Mono', monospace;
    font-size: 10px;
    padding: 4px 10px;
    background: rgba(124,58,237,0.1);
    border: 1px solid rgba(124,58,237,0.25);
    color: var(--plasma-glow);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .multiplier-bar {
    margin-top: 20px;
  }

  .mult-label {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-family: 'Share Tech Mono', monospace;
    color: var(--text-dim);
    margin-bottom: 6px;
    letter-spacing: 1px;
  }

  .mult-track {
    height: 4px;
    background: rgba(255,255,255,0.06);
    border-radius: 2px;
    overflow: hidden;
  }

  .mult-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--plasma), var(--plasma-glow));
    border-radius: 2px;
    transition: width 1s ease-out;
  }

  /* PRICING */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .price-card {
    background: var(--panel);
    border: 1px solid var(--border);
    padding: 40px 32px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s;
  }

  .price-card.featured {
    border-color: var(--plasma-glow);
    background: linear-gradient(135deg, var(--panel), rgba(124,58,237,0.08));
  }

  .price-card.featured::before {
    content: 'MOST POPULAR';
    position: absolute;
    top: 16px;
    right: 16px;
    font-family: 'Orbitron', sans-serif;
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--plasma-glow);
    background: rgba(124,58,237,0.15);
    padding: 4px 10px;
    border: 1px solid rgba(124,58,237,0.3);
  }

  .price-card:hover {
    transform: translateY(-8px);
    border-color: var(--border-bright);
  }

  .price-card.featured:hover { border-color: var(--plasma-glow); }

  .plan-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 13px;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--text-dim);
    margin-bottom: 8px;
  }

  .plan-price {
    font-family: 'Orbitron', sans-serif;
    font-size: 52px;
    font-weight: 900;
    color: #fff;
    line-height: 1;
    margin-bottom: 4px;
  }

  .plan-price sup {
    font-size: 20px;
    font-weight: 400;
    vertical-align: super;
    color: var(--text-dim);
  }

  .plan-period {
    font-size: 13px;
    color: var(--text-dim);
    margin-bottom: 32px;
  }

  .plan-features {
    list-style: none;
    margin-bottom: 32px;
  }

  .plan-features li {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .plan-features li::before {
    content: '◆';
    font-size: 8px;
    color: var(--cyan);
    flex-shrink: 0;
  }

  .plan-features li:last-child { border-bottom: none; }

  .plan-btn {
    width: 100%;
    padding: 16px;
    font-family: 'Orbitron', sans-serif;
    font-size: 11px;
    letter-spacing: 3px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s;
    clip-path: polygon(10px 0%, 100% 0%, calc(100% - 10px) 100%, 0% 100%);
    border: none;
  }

  .plan-btn.basic {
    background: transparent;
    border: 1px solid var(--border-bright);
    color: var(--text);
  }
  .plan-btn.basic:hover { background: rgba(255,255,255,0.05); }

  .plan-btn.pro {
    background: linear-gradient(135deg, var(--plasma), #4f46e5);
    color: white;
