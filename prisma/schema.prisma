datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  role      String   @default("user")
  createdAt DateTime @default(now())
  nodes     Node[]
}

model Node {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  status       String   @default("Offline")
  ipAddress    String?
  deviceName   String
  lastPing     DateTime @updatedAt
  safeHarbor   Boolean  @default(true)
}

model Inquiry {
  id        String   @id @default(cuid())
  type      String
  email     String
  message   String
  createdAt DateTime @default(now())
}