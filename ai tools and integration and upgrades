        self.public_rooms = {}
        self.economy_system = EconomySystem()
        
    def add_ai_to_catalog(self, ai_name, ai_instance):
        """Add AI to the catalog for management"""
        self.ai_catalog[ai_name] = ai_instance
        
    def create_upgrade(self, name, category, description, cost, effects):
        """Create a new AI upgrade"""
        self.upgrade_catalog[name] = {
            'category': category,
            'description': description,
            'cost': cost,
            'effects': effects
        }
        
    def deploy_laboratory(self, ai_name, tuning_parameters):
        """Deploy AI in laboratory for tuning"""
        if ai_name in self.ai_catalog:
            return self.laboratory.tune_ai(self.ai_catalog[ai_name], tuning_parameters)
        return "AI not found in catalog"

