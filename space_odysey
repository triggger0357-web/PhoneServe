<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VOID ODYSSEY — Space RPG</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Share+Tech+Mono&family=Exo+2:ital,wght@0,300;0,400;1,300&display=swap');

  :root {
    --void: #020409;
    --deep: #060d1a;
    --panel: #0a1628;
    --border: #1a3a6b;
    --glow: #00d4ff;
    --glow2: #7b2fff;
    --gold: #ffd700;
    --danger: #ff3b3b;
    --success: #00ff88;
    --text: #c8dff5;
    --dim: #4a6a8a;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--void);
    color: var(--text);
    font-family: 'Share Tech Mono', monospace;
    min-height: 100vh;
    overflow-x: hidden;
    position: relative;
  }

  /* STARFIELD */
  #starfield {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }
  .star {
    position: absolute;
    border-radius: 50%;
    background: white;
    animation: twinkle var(--d) ease-in-out infinite alternate;
  }
  @keyframes twinkle {
    from { opacity: var(--min); transform: scale(1); }
    to { opacity: var(--max); transform: scale(1.4); }
  }
  .nebula {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.06;
    animation: drift 30s ease-in-out infinite alternate;
  }
  @keyframes drift {
    from { transform: translate(0, 0) scale(1); }
    to { transform: translate(30px, -20px) scale(1.1); }
  }

  /* LAYOUT */
  #app {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 20px;
  }

  /* HEADER */
  header {
    text-align: center;
    padding: 30px 0 20px;
    position: relative;
  }
  .logo {
    font-family: 'Orbitron', monospace;
    font-weight: 900;
    font-size: clamp(28px, 6vw, 52px);
    letter-spacing: 0.15em;
    background: linear-gradient(135deg, var(--glow) 0%, var(--glow2) 50%, var(--gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-shadow: none;
    position: relative;
  }
  .logo::after {
    content: 'VOID ODYSSEY';
    position: absolute;
    inset: 0;
    font-family: 'Orbitron', monospace;
    font-weight: 900;
    -webkit-text-fill-color: transparent;
    filter: blur(20px);
    background: linear-gradient(135deg, var(--glow), var(--glow2));
    -webkit-background-clip: text;
    background-clip: text;
    opacity: 0.5;
  }
  .tagline {
    font-family: 'Exo 2', sans-serif;
    font-style: italic;
    color: var(--dim);
    font-size: 13px;
    letter-spacing: 0.3em;
    margin-top: 6px;
  }

  /* STATS BAR */
  #stats-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin: 16px 0;
    display: none;
  }
  .stat-box {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 10px 12px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .stat-box::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--glow), transparent);
    opacity: 0.5;
  }
  .stat-label {
    font-size: 9px;
    letter-spacing: 0.2em;
    color: var(--dim);
    text-transform: uppercase;
  }
  .stat-value {
    font-family: 'Orbitron', monospace;
    font-size: 18px;
    font-weight: 700;
    margin-top: 2px;
  }
  .stat-value.hp { color: var(--success); }
  .stat-value.credits { color: var(--gold); }
  .stat-value.xp { color: var(--glow2); }
  .stat-value.level { color: var(--glow); }

  /* MAIN PANEL */
  #main-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* SCENE DISPLAY */
  #scene-area {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 24px;
    position: relative;
    overflow: hidden;
    min-height: 300px;
  }
  #scene-area::before {
    content: '';
    position: absolute;
    top: -1px; left: 20%; right: 20%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--glow), var(--glow2), transparent);
    border-radius: 2px;
  }

  .scene-header {
    font-family: 'Orbitron', monospace;
    font-size: 11px;
    letter-spacing: 0.3em;
    color: var(--glow);
    text-transform: uppercase;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .scene-header::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }
  .pulse-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: var(--glow);
    animation: pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; box-shadow: 0 0 6px var(--glow); }
    50% { opacity: 0.3; box-shadow: none; }
  }

  #scene-text {
    font-family: 'Exo 2', sans-serif;
    font-size: 15px;
    line-height: 1.8;
    color: var(--text);
    white-space: pre-wrap;
  }
  #scene-text .typing-cursor {
    display: inline-block;
    width: 2px;
    height: 1em;
    background: var(--glow);
    animation: blink 1s step-end infinite;
    vertical-align: text-bottom;
    margin-left: 2px;
  }
  @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

  /* CHOICES */
  #choices-area {
    display: grid;
    gap: 8px;
  }
  .choice-btn {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--text);
    font-family: 'Share Tech Mono', monospace;
    font-size: 14px;
    padding: 14px 20px;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .choice-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--glow), var(--glow2));
    opacity: 0;
    transition: opacity 0.2s;
  }
  .choice-btn:hover::before { opacity: 0.08; }
  .choice-btn:hover {
    border-color: var(--glow);
    color: #fff;
    transform: translateX(4px);
    box-shadow: -3px 0 0 var(--glow), 0 0 20px rgba(0,212,255,0.1);
  }
  .choice-btn:active { transform: translateX(2px) scale(0.99); }
  .choice-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
    transform: none;
  }
  .choice-num {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    color: var(--glow);
    background: rgba(0,212,255,0.1);
    border: 1px solid rgba(0,212,255,0.3);
    border-radius: 4px;
    padding: 2px 7px;
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }
  .choice-text { position: relative; z-index: 1; }

  /* LOADING */
  #loading {
    display: none;
    align-items: center;
    gap: 12px;
    padding: 16px 0;
    color: var(--dim);
    font-size: 13px;
  }
  .loading-dots {
    display: flex; gap: 5px;
  }
  .loading-dots span {
    width: 5px; height: 5px;
    border-radius: 50%;
    background: var(--glow);
    animation: loadpulse 1.2s ease-in-out infinite;
  }
  .loading-dots span:nth-child(2) { animation-delay: 0.2s; }
  .loading-dots span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes loadpulse {
    0%, 100% { opacity: 0.2; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.2); }
  }

  /* CHARACTER CREATION */
  #char-create {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 28px;
  }
  #char-create h2 {
    font-family: 'Orbitron', monospace;
    font-size: 14px;
    letter-spacing: 0.2em;
    color: var(--glow);
    margin-bottom: 6px;
  }
  #char-create p {
    font-family: 'Exo 2', sans-serif;
    color: var(--dim);
    font-size: 13px;
    margin-bottom: 20px;
  }
  .input-group { margin-bottom: 16px; }
  .input-group label {
    display: block;
    font-size: 11px;
    letter-spacing: 0.2em;
    color: var(--glow2);
    margin-bottom: 6px;
    text-transform: uppercase;
  }
  .input-group input, .input-group select {
    width: 100%;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text);
    font-family: 'Share Tech Mono', monospace;
    font-size: 14px;
    padding: 10px 14px;
    outline: none;
    transition: border-color 0.2s;
  }
  .input-group input:focus, .input-group select:focus {
    border-color: var(--glow);
    box-shadow: 0 0 12px rgba(0,212,255,0.1);
  }
  .input-group select option { background: var(--deep); }

  .class-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-bottom: 20px;
  }
  .class-card {
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 14px 10px;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s;
  }
  .class-card:hover { border-color: var(--glow2); }
  .class-card.selected {
    border-color: var(--glow);
    background: rgba(0,212,255,0.06);
    box-shadow: 0 0 20px rgba(0,212,255,0.1);
  }
  .class-icon { font-size: 28px; margin-bottom: 8px; }
  .class-name {
    font-family: 'Orbitron', monospace;
    font-size: 10px;
    color: var(--glow);
    letter-spacing: 0.1em;
  }
  .class-desc {
    font-size: 10px;
    color: var(--dim);
    margin-top: 4px;
    font-family: 'Exo 2', sans-serif;
  }

  .start-btn {
    width: 100%;
    background: linear-gradient(135deg, rgba(0,212,255,0.15), rgba(123,47,255,0.15));
    border: 1px solid var(--glow);
    border-radius: 8px;
    color: var(--glow);
    font-family: 'Orbitron', monospace;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.2em;
    padding: 16px;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }
  .start-btn:hover {
    background: linear-gradient(135deg, rgba(0,212,255,0.25), rgba(123,47,255,0.25));
    box-shadow: 0 0 30px rgba(0,212,255,0.2);
    transform: translateY(-1px);
  }

  /* LOG */
  #log-area {
    background: rgba(6,13,26,0.8);
    border: 1px solid rgba(26,58,107,0.5);
    border-radius: 8px;
    padding: 14px 16px;
    max-height: 120px;
    overflow-y: auto;
    display: none;
  }
  #log-area::-webkit-scrollbar { width: 3px; }
  #log-area::-webkit-scrollbar-track { background: transparent; }
  #log-area::-webkit-scrollbar-thumb { background: var(--border); border-radius: 2px; }
  .log-entry {
    font-size: 12px;
    color: var(--dim);
    line-height: 1.6;
    padding: 2px 0;
    border-bottom: 1px solid rgba(26,58,107,0.2);
  }
  .log-entry:last-child { border: none; }
  .log-entry .log-tag {
    color: var(--glow2);
    font-size: 10px;
    letter-spacing: 0.1em;
  }
  .log-entry.success .log-tag { color: var(--success); }
  .log-entry.danger .log-tag { color: var(--danger); }

  /* INVENTORY PANEL */
  #inventory-bar {
    display: none;
    gap: 8px;
    flex-wrap: wrap;
  }
  .inv-item {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    color: var(--gold);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  /* HP BAR */
  .hp-bar-wrap {
    margin-top: 8px;
    height: 4px;
    background: rgba(255,255,255,0.05);
    border-radius: 2px;
    overflow: hidden;
  }
  .hp-bar-fill {
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--success), #00cc70);
    transition: width 0.5s ease;
  }
  .hp-bar-fill.low { background: linear-gradient(90deg, var(--danger), #ff6b00); }

  /* COMBAT EFFECTS */
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-6px); }
    40% { transform: translateX(6px); }
    60% { transform: translateX(-4px); }
    80% { transform: translateX(4px); }
  }
  .shake { animation: shake 0.4s ease; }

  @keyframes flash-red {
    0% { background: rgba(255,59,59,0.15); }
    100% { background: transparent; }
  }
  .flash-damage { animation: flash-red 0.5s ease; }

  /* CHEAT PANEL */
  #cheat-panel {
    background: rgba(255,215,0,0.05);
    border: 1px solid rgba(255,215,0,0.3);
    border-radius: 10px;
    padding: 16px;
    display: none;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
  .cheat-btn {
    background: rgba(255,215,0,0.1);
    border: 1px solid rgba(255,215,0,0.4);
    border-radius: 6px;
    color: var(--gold);
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
    padding: 8px 14px;
    cursor: pointer;
    transition: all 0.2s;
  }
  .cheat-btn:hover {
    background: rgba(255,215,0,0.2);
    box-shadow: 0 0 12px rgba(255,215,0,0.2);
  }
  #cheat-toggle {
    background: transparent;
    border: 1px dashed rgba(255,215,0,0.3);
    border-radius: 6px;
    color: rgba(255,215,0,0.5);
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    padding: 6px 12px;
    cursor: pointer;
    transition: all 0.2s;
    display: none;
    letter-spacing: 0.1em;
  }
  #cheat-toggle:hover { color: var(--gold); border-color: var(--gold); }

  /* PAYWALL */
  #paywall {
    position: fixed;
    inset: 0;
    background: rgba(2,4,9,0.97);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .pay-box {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 32px 28px;
    max-width: 480px;
    width: 100%;
    position: relative;
    overflow: hidden;
  }
  .pay-box::before {
    content: '';
    position: absolute;
    top: -1px; left: 15%; right: 15%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--gold), transparent);
  }
  .pay-title {
    font-family: 'Orbitron', monospace;
    font-size: 20px;
    font-weight: 900;
    color: var(--gold);
    text-align: center;
    margin-bottom: 6px;
  }
  .pay-sub {
    font-family: 'Exo 2', sans-serif;
    color: var(--dim);
    font-size: 13px;
    text-align: center;
    margin-bottom: 24px;
  }
  .tier-card {
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 16px 18px;
    margin-bottom: 12px;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    overflow: hidden;
  }
  .tier-card:hover { border-color: var(--gold); background: rgba(255,215,0,0.04); }
  .tier-card.popular {
    border-color: var(--glow);
    background: rgba(0,212,255,0.04);
  }
  .popular-badge {
    position: absolute;
    top: 10px; right: 12px;
    background: var(--glow);
    color: var(--void);
    font-family: 'Orbitron', monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border-radius: 20px;
  }
  .tier-name {
    font-family: 'Orbitron', monospace;
    font-size: 13px;
    color: var(--text);
    font-weight: 700;
  }
  .tier-price {
    font-family: 'Orbitron', monospace;
    font-size: 22px;
    font-weight: 900;
    color: var(--gold);
    margin: 4px 0;
  }
  .tier-price span { font-size: 13px; color: var(--dim); font-weight: 400; }
  .tier-perks {
    font-family: 'Exo 2', sans-serif;
    font-size: 12px;
    color: var(--dim);
    line-height: 1.7;
    margin-top: 6px;
  }
  .tier-perks .perk { color: var(--success); }
  .cashapp-btn {
    display: block;
    width: 100%;
    background: linear-gradient(135deg, #00d632, #00a826);
    border: none;
    border-radius: 10px;
    color: white;
    font-family: 'Orbitron', monospace;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.1em;
    padding: 16px;
    cursor: pointer;
    margin-top: 20px;
    transition: all 0.2s;
    text-decoration: none;
    text-align: center;
  }
  .cashapp-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(0,214,50,0.3);
  }
  .pay-note {
    font-family: 'Exo 2', sans-serif;
    font-size: 11px;
    color: var(--dim);
    text-align: center;
    margin-top: 14px;
    line-height: 1.6;
  }
  .pay-note strong { color: var(--gold); }
  .already-paid {
    background: transparent;
    border: 1px dashed var(--border);
    border-radius: 8px;
    color: var(--dim);
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
    padding: 10px;
    cursor: pointer;
    width: 100%;
    margin-top: 10px;
    transition: all 0.2s;
  }
  .already-paid:hover { color: var(--text); border-color: var(--glow2); }

  /* RESPONSIVE */
  @media (max-width: 600px) {
    .class-grid { grid-template-columns: repeat(3, 1fr); }
    #stats-bar { grid-template-columns: repeat(2, 1fr); }
    .logo { font-size: 26px; }
  }
</style>
</head>
<body>

<div id="starfield"></div>

<div id="agegate" style="position:fixed;inset:0;background:rgba(2,4,9,0.98);z-index:200;display:flex;align-items:center;justify-content:center;padding:20px;">
  <div class="pay-box" style="text-align:center;">
    <div style="font-size:48px;margin-bottom:12px;">🛸</div>
    <div class="pay-title" style="color:var(--glow);">AGE VERIFICATION</div>
    <div class="pay-sub" style="margin-bottom:24px;">By law, you must be <strong style="color:white;">18 or older</strong> to access Void Odyssey. Please confirm your date of birth.</div>

    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:20px;">
      <div class="input-group" style="margin:0;">
        <label>Month</label>
        <select id="age-month">
          <option value="">MM</option>
          ${Array.from({length:12},(_,i)=>`<option value="${i+1}">${String(i+1).padStart(2,'0')}</option>`).join('')}
        </select>
      </div>
      <div class="input-group" style="margin:0;">
        <label>Day</label>
        <select id="age-day">
          <option value="">DD</option>
          ${Array.from({length:31},(_,i)=>`<option value="${i+1}">${String(i+1).padStart(2,'0')}</option>`).join('')}
        </select>
      </div>
      <div class="input-group" style="margin:0;">
        <label>Year</label>
        <select id="age-year">
          <option value="">YYYY</option>
          ${Array.from({length:100},(_,i)=>`<option value="${2026-i}">${2026-i}</option>`).join('')}
        </select>
      </div>
    </div>

    <button class="start-btn" onclick="verifyAge()">CONFIRM AGE & ENTER</button>

    <div class="pay-note" style="margin-top:16px;">
      This site is intended for users <strong>18 years of age or older.</strong><br>
      By entering, you confirm you meet the minimum age requirement.<br><br>
      <span style="color:rgba(255,255,255,0.2);font-size:10px;">
        COPPA · CIPA · State Age Verification Laws Compliant
      </span>
    </div>
  </div>
</div>

<div id="paywall">
  <div class="pay-box">
    <div class="pay-title">⬡ VOID ODYSSEY</div>
    <div class="pay-sub">Choose your pilot license to begin your journey</div>

    <div class="tier-card" onclick="selectTier('basic', '$4.99/mo', 'cashtag=$davidingalls1061&amount=4.99&note=VoidOdyssey+Basic+Monthly')">
      <div class="tier-name">🚀 EXPLORER LICENSE</div>
      <div class="tier-price">$4.99 <span>/ month</span></div>
      <div class="tier-perks">
        <span class="perk">✓</span> Full story access & AI narrative<br>
        <span class="perk">✓</span> All 6 pilot classes<br>
        <span class="perk">✓</span> Standard inventory & credits<br>
        ✗ Upgrades & cheat console
      </div>
    </div>

    <div class="tier-card popular" onclick="selectTier('upgrade', '$0.99 upgrade', 'cashtag=$davidingalls1061&amount=0.99&note=VoidOdyssey+Upgrade+Pack')">
      <div class="popular-badge">ADD-ON</div>
      <div class="tier-name">⚡ UPGRADE PACK</div>
